<UserControl x:Class="WinFWManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             KeyDown="UserControl_KeyDown">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Summary Cards -->
            <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,16">
                <!-- Total Connections -->
                <Border Background="{DynamicResource SecondaryBgBrush}" CornerRadius="6" Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Total Connections" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalConnections}" Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Blocked -->
                <Border Background="{DynamicResource SecondaryBgBrush}" CornerRadius="6" Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Blocked" Foreground="{DynamicResource DangerBrush}" FontSize="12"/>
                        <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0">
                            <Run Text="{Binding BlockedConnections, Mode=OneWay}"/>
                            <Run Text=" ("/>
                            <Run Text="{Binding BlockedPercent, Mode=OneWay, StringFormat='{}{0:F1}%'}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Allowed -->
                <Border Background="{DynamicResource SecondaryBgBrush}" CornerRadius="6" Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Allowed" Foreground="{DynamicResource SuccessBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding AllowedConnections}" Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Direction -->
                <Border Background="{DynamicResource SecondaryBgBrush}" CornerRadius="6" Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Direction" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0">
                            <Run Text="In: "/><Run Text="{Binding InboundCount, Mode=OneWay}"/>
                            <Run Text="  Out: "/><Run Text="{Binding OutboundCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Network Traffic Graph -->
            <Border Grid.Row="1" Background="{DynamicResource SecondaryBgBrush}"
                    CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0" Text="Network Traffic Graph"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <!-- Filter Row (shared semantics with Traffic Monitor) -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBlock Text="Src IP:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding FilterSourceIp, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,8,4"/>
                            <TextBlock Text="Src Port:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding FilterSrcPort, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,8,4"/>
                            <TextBlock Text="Dst IP:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding FilterDestIp, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,8,4"/>
                            <TextBlock Text="Dst Port:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding FilterDstPort, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,8,4"/>
                            <TextBlock Text="Protocol:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding FilterProtocol, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,8,4"/>
                            <TextBlock Text="Process:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding FilterProcess, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,8,4"/>
                            <TextBlock Text="NIC:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding FilterNic, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,8,4"/>
                            <TextBlock Text="Action:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding FilterAction, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,8,4"/>
                            <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" Margin="8,0,0,4"/>
                        </WrapPanel>
                        <TextBlock Text="Tip: prefix with ! to exclude (e.g. !svchost)  •  comma-separate multiple terms (e.g. !10.0.0.1,!192.168.1.1)"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,3,0,0" Opacity="0.6"/>
                    </StackPanel>

                    <!-- Drill chip -->
                    <Border Grid.Row="2" CornerRadius="10"
                            Background="{DynamicResource TertiaryBgBrush}"
                            Padding="8,3" Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Visibility="{Binding HasDrill, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DrillLabel, StringFormat='⊘ {0}'}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <Button Content="✕" Command="{Binding ClearDrillCommand}"
                                    Padding="4,0" Margin="6,0,0,0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Graph Canvas -->
                    <Canvas x:Name="GraphCanvas" Grid.Row="3"
                            ClipToBounds="True"
                            Background="Transparent"
                            Height="380"
                            SizeChanged="GraphCanvas_SizeChanged"/>
                </Grid>
            </Border>

            <!-- Top Talkers -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SecondaryBgBrush}" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Top Destinations" Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding TopTalkers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Address}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Country}" Margin="8,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource SecondaryBgBrush}" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Top Blocked" Foreground="{DynamicResource DangerBrush}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding TopBlocked}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Address}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Country}" Margin="8,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
